DATABASE_URL=postgres://postgres:postgres@localhost:5432/skillflix
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Configure both the browser and API with the same Google OAuth web client ID.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Optional SMTP for verification and password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Set in the web host for a separately deployed API, e.g. https://api.example.com
VITE_API_URL=
# Set in the web build environment for sitemap generation.
SITE_URL=http://localhost:5173
# Set only when running the one-time admin:provision command; do not store real values here.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
